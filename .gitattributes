# Optional Git LFS tracking for large weight files.
# Enable with:  git lfs install && git lfs track "*.pt" "*.pth"
# GitHub LFS has a bandwidth/storage quota; prefer Hugging Face / a GitHub Release
# for the ~3 x 1.16 GB deployed checkpoints (see models/README.md).
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
